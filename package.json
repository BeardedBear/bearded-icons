{
  "name": "bearded-icons-build",
  "private": true,
  "scripts": {
    "build": "vite-node src/main.ts",
    "build:vscode": "vite-node src/build-vscode.ts",
    "build:zed": "vite-node src/build-zed.ts",
    "build:ext": "cd dist/vscode && vsce package",
