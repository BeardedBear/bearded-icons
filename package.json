    "ts-node": "^10.9.2",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.5.0",
    "eslint": "^9.26.0",
    "globby": "^14.1.0",
    "ovsx": "^0.10.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite-node": "^3.1.2"
