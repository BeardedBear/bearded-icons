{
  "name": "bearded-icons-build",
  "private": true,
  "scripts": {
    "build": "npm run build:vscode && npm run build:zed",
    "build:vscode": "bun run src/vscode/build.ts",
    "build:zed": "bun run src/zed/build.ts",
    "build:ext": "cd dist/vscode && vsce package",
    "dev": "npm run dev:vscode",
    "dev:vscode": "bun --watch src/vscode/build.ts",
    "dev:zed": "bun --watch src/zed/build.ts",
    "fix": "prettier --write src/**/*.ts",
    "optimize-svg": "bun run scripts/optimize-svg.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.1",
    "chalk": "^5.4.1",
    "node": "^22.15.0",
    "svgo": "^3.3.2",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.5.0",
    "eslint": "^9.26.0",
    "globby": "^14.1.0",
    "ovsx": "^0.10.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
